# =========================================================
# XP LEGACY - Backend (FastAPI)
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# `.env` está en .gitignore: NUNCA se sube a git.
# =========================================================

# --- Obligatorio: Supabase ---
# URL del proyecto en Supabase (Project Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave del servidor (service_role) o anónima (anon).
# Esta clave NUNCA se expone al navegador: solo la lee el backend.
SUPABASE_KEY=

# --- Orígenes CORS permitidos (separados por coma) ---
# Admite comodines para previews de Vercel: https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://proyecto-fullstack-1.vercel.app,https://*.vercel.app

# --- Integración IGDB / Twitch (opcional, Fase 3) ---
# Credenciales de https://dev.twitch.tv/console
# Almacenadas SOLO en el servidor. No usar el prefijo VITE_ jamás:
# cualquier variable VITE_* se incluye en el bundle JavaScript público.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
