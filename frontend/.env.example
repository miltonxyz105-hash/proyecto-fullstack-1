# =========================================================
# XP LEGACY - Frontend (Vite / React)
# Copia este archivo a `.env.local` y ajusta los valores.
#   cp .env.example .env.local
# =========================================================

# ÚNICA variable expuesta al navegador: la URL base de la API.
# Cualquier variable debe llevar el prefijo VITE_ para que Vite la
# incluya en el build, y por eso SOLO puede contener datos públicos.
#
# PROHIBIDO aquí: SUPABASE_KEY, TWITCH_CLIENT_SECRET, OPENAI_API_KEY,
# o cualquier secreto. Ese tipo de claves viven en backend/.env.
VITE_API_URL=https://proyecto-fullstack-1-moip.onrender.com
